{
  "name": "voterspheres-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check:syntax": "node scripts/check-js-syntax.mjs",
    "test:tenant-isolation": "node --test tests/tenant-isolation.contract.test.mjs",
    "test:election-cycles": "node --test tests/electionCycle.contract.test.mjs",
    "audit:election-cycles": "node scripts/auditElectionCycles.js",
    "dev": "node index.js",
    "dev:clean": "kill-port 10000 && node index.js",
    "start": "node index.js",
    "start:clean": "kill-port 10000 && node index.js",
    "db:workspaces": "node scripts/createCampaignWorkspaces.js",
    "restart": "npm run start:clean",
    "check:api": "powershell -Command \"Invoke-WebRequest http://127.0.0.1:10000/api/health -UseBasicParsing | Select-Object StatusCode, StatusDescription\"",
    "db:migrate": "node db/runMigrations.js",
    "db:seed": "node db/seed.js",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:migrate:influence": "node scripts/migrateInfluenceEngine.js",
    "ingest:once": "node jobs/providerIngestion.jobRunner.js",
    "sync:fec": "node scripts/syncFecData.js",
    "sync:candidate-contacts": "node scripts/enrich-candidate-contacts.js",
    "import:consultants": "node scripts/import-consultants-from-fec.js",
    "enrich:consultant-contacts": "node scripts/enrich-consultant-contacts.js",
    "import:localities": "node scripts/importStateLocalities.js",
    "import:usps-facilities": "node scripts/import-usps-postal-facilities.js",
    "db:migrate:coalitions": "node scripts/migrateCoalitionIntelligence.js",
    "db:migrate:strategy": "node scripts/migrateStrategyRecommendations.js",
    "signals:fec": "node scripts/importPoliticalSignalsFromFec.js",
    "db:migrate:influence-forecasts": "node scripts/migrateInfluenceForecasts.js",
    "signals:news": "node scripts/importNewsNarrativeSignals.js",
    "test:polling-cycle-diagnostics": "node --test tests/pollingCycleDiagnostic.contract.test.mjs",
    "diagnose:polling-cycles": "node scripts/diagnosePollingElectionCycles.mjs",
    "test:cycle-isolation": "node --test tests/electionCycleIsolation.contract.test.mjs",
    "audit:cycle-isolation": "node scripts/auditCycleIsolation.mjs",
    "test:polling-cycle-remediation": "node --test tests/pollingCycleRemediation.contract.test.mjs",
    "remediate:polling-cycles": "node scripts/remediatePollingCycles.mjs",
    "rollback:polling-cycles": "node scripts/rollbackPollingCycleRemediation.mjs",
    "test:polling-ingestion-cycle-guard": "node --test tests/pollingIngestionCycleGuard.contract.test.mjs",
    "audit:polling-ingestion-cycles": "node scripts/auditPollingIngestionCycles.mjs",
