    "canary:polling-ingestion": "node scripts/runPollingIngestionCanary.mjs",
    "test:polling-temporal-scope": "node --test tests/pollingTemporalScope.contract.test.mjs",
    "audit:polling-temporal-scope": "node scripts/auditPollingTemporalScopes.mjs",
    "test:polling-temporal-scope-api": "node --test tests/executivePollingTemporalScope.contract.test.mjs",
    "test:polling-deployment-validation": "node --test tests/pollingTemporalScopeDeployment.contract.test.mjs",
    "validate:polling-deployment": "node scripts/validatePollingTemporalScopeDeployment.mjs",
    "test:polling-quarantine-closeout": "node --test tests/pollingQuarantineCloseout.contract.test.mjs",
    "audit:polling-quarantine-closeout": "node scripts/auditPollingQuarantineCloseout.mjs",
    "monitor:polling-operations": "node scripts/monitorPollingOperations.mjs",
    "test:polling-operations-monitor": "node --test tests/pollingOperationsMonitor.contract.test.mjs",
    "test:executive-polling-evidence": "node --test tests/executivePollingEvidence.contract.test.mjs",
    "test:executive-polling-prose": "node --test tests/executivePollingProse.contract.test.mjs",
    "test:fec-sync-guard": "node --test tests/fecSyncGuard.contract.test.mjs",
    "test:future-cycle-evidence": "node --test tests/campaignCycleEvidence.contract.test.mjs tests/futureCycleBounds.contract.test.mjs",
    "test:planning-integrity": "node --test tests/planningIntegrity.contract.test.mjs",
    "test:copilot-generation-feedback": "node --test tests/copilotGenerationFeedback.contract.test.mjs",
    "test:election-phase-integrity": "node --test tests/electionPhaseIntegrity.contract.test.mjs",
    "test:election-phase-integrity-r2": "node --test tests/electionPhaseIntegrityR2.contract.test.mjs",
    "test:election-phase-integrity-r3": "node --test tests/electionPhaseIntegrityR3.contract.test.mjs"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "openai": "^6.46.0",
    "pg": "^8.20.0",
    "redis": "^5.10.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.2",
    "kill-port": "^2.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
